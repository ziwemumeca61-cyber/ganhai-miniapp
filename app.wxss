page {
  background: #f6f1e6;
  color: #274d4e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, scroll-view, map {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.safe-bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.page-shell {
  min-height: 100vh;
  padding: 36rpx 30rpx 60rpx;
}

.eyebrow {
  color: #8c8b75;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.muted {
  color: #878571;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 0 20rpx;
}

.section-title .title {
  color: #294f50;
  font-size: 34rpx;
  font-weight: 700;
}

.section-title .link {
  color: #bd704e;
  font-size: 24rpx;
}

.card {
  border: 1rpx solid #ded7c5;
  border-radius: 18rpx;
  background: #fffcf4;
  box-shadow: none;
}

.pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #ebeede;
  color: #bd704e;
  font-size: 22rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  border-radius: 22rpx;
  background: #bd704e;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border: 1rpx solid #d9d0b9;
  border-radius: 20rpx;
  background: #fffcf4;
  color: #bd704e;
  font-size: 26rpx;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e4ddca;
}
