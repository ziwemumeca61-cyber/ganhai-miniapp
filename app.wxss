page {
  background: #f4f8fa;
  color: #16343c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, scroll-view, map {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.safe-bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.page-shell {
  min-height: 100vh;
  padding: 36rpx 30rpx 60rpx;
}

.eyebrow {
  color: #6e8d95;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.muted {
  color: #7d9299;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 0 20rpx;
}

.section-title .title {
  color: #173c45;
  font-size: 34rpx;
  font-weight: 700;
}

.section-title .link {
  color: #087f88;
  font-size: 24rpx;
}

.card {
  border: 1rpx solid rgba(24, 81, 90, .06);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 14rpx 40rpx rgba(31, 91, 102, .08);
}

.pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #eaf6f5;
  color: #087f88;
  font-size: 22rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  border-radius: 22rpx;
  background: #087f88;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border: 1rpx solid #d4e8e9;
  border-radius: 20rpx;
  background: #f5fbfb;
  color: #087f88;
  font-size: 26rpx;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #edf3f4;
}
