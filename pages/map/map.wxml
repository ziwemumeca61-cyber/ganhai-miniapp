<view class="map-page">
  <map class="coast-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" show-location="{{located}}" enable-zoom="true" enable-scroll="true" bindmarkertap="markerTap"></map>
  <view class="map-gradient"></view>
  <view class="map-header">
    <picker mode="selector" range="{{cityOptions}}" range-key="name" value="{{cityIndex}}" bindchange="chooseCity">
      <view class="map-title"><text>{{cityName}}附近 ⌄</text><text class="map-subtitle">{{spots.length}} 个{{cityName}}沿海地点 · 按实际距离排序</text></view>
    </picker>
    <view class="map-locate" bindtap="refreshLocation"><text>⊙</text><text>{{locating ? '定位中' : located ? '精度' + locationAccuracy + 'm' : '重新定位'}}</text></view>
  </view>
  <view class="map-legend">
    <view><text class="legend-dot hot"></text>安全可评估</view>
    <view><text class="legend-dot normal"></text>待海况</view>
    <view><text class="legend-dot rest"></text>待核验</view>
  </view>

  <view class="map-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-title-row"><text class="sheet-title">距离最近的沿海地点</text><text class="sheet-hint">距离优先 · 安全兼顾</text></view>
    <scroll-view class="spot-scroll" scroll-x="true" enable-flex="true">
      <view wx:for="{{spots}}" wx:key="id" class="map-spot-card {{selected.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectSpot">
        <view class="map-score"><text>{{item.safetyScore === null ? '--' : item.safetyScore}}</text><text>安全</text></view>
        <view class="map-spot-name">{{item.name}}</view>
        <view class="map-spot-meta">{{item.distanceLabel}} · {{item.verification}}</view>
        <view class="map-spot-level">{{item.level}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{selected}}" class="selected-preview card">
      <view class="preview-main">
        <view class="preview-kicker">{{selected.verification}} · {{selected.type}}</view>
        <view class="preview-title">{{selected.name}}</view>
        <view class="preview-desc">{{selected.shoreSide}} · {{selected.offshoreRange}}</view>
        <view class="preview-desc">{{selected.catchForecast}}</view>
      </view>
      <view class="preview-actions">
        <view class="preview-btn light" bindtap="navigateToSpot">导航</view>
        <view class="preview-btn dark" bindtap="goDetail">详情</view>
      </view>
    </view>
  </view>
</view>
