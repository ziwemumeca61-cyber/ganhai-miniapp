.spot-page {
  padding-top: 28rpx;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.detail-title {
  margin-top: 10rpx;
  color: #173f48;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.detail-meta {
  margin-top: 10rpx;
  color: #91a5aa;
  font-size: 20rpx;
}

.detail-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #e29243;
}

.detail-score text:first-child {
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-score text:last-child {
  margin-top: 8rpx;
  color: #a37d57;
  font-size: 19rpx;
}

.zone-card {
  overflow: hidden;
  padding: 28rpx 24rpx 24rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f3fbfa 100%);
}

.zone-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.zone-kicker {
  display: block;
  color: #70a9a5;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.zone-title {
  display: block;
  margin-top: 8rpx;
  color: #17434b;
  font-size: 32rpx;
  font-weight: 700;
}

.zone-status {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 99rpx;
  font-size: 17rpx;
  font-weight: 700;
}

.zone-status.ready { background: #e6f6f2; color: #187f72; }
.zone-status.pending { background: #fff2df; color: #a76a2f; }

.best-zone {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #9ed6cb;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #e8f8f4, #f7fcfa);
}

.best-zone.pending {
  border-color: #ebd0a7;
  background: linear-gradient(135deg, #fff5e6, #fffaf2);
}

.best-zone text { display: block; }
.best-zone-label { color: #5e9691; font-size: 18rpx; font-weight: 700; }
.best-zone-name { margin-top: 8rpx; color: #12474e; font-size: 30rpx; font-weight: 800; line-height: 1.45; }
.best-zone-source { margin-top: 8rpx; color: #4c8986; font-size: 18rpx; font-weight: 700; }
.best-zone-note { margin-top: 10rpx; color: #7b979a; font-size: 18rpx; line-height: 1.55; }


.catch-summary {
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-left: 7rpx solid #e29243;
  color: #416b70;
  font-size: 22rpx;
  line-height: 1.65;
}

.zone-route {
  margin-top: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 18rpx;
  background: #f5f9f9;
}

.route-step { display: flex; align-items: flex-start; padding: 17rpx 0; border-bottom: 1rpx solid #e3eeee; }
.route-step:last-child { border-bottom: 0; }
.route-index { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 38rpx; height: 38rpx; margin-right: 14rpx; border-radius: 50%; background: #168b85; color: #fff; font-size: 18rpx; font-weight: 800; }
.route-copy text { display: block; }
.route-copy text:first-child { color: #6f9699; font-size: 18rpx; font-weight: 700; }
.route-copy text:last-child { margin-top: 6rpx; color: #315f65; font-size: 21rpx; line-height: 1.55; }

.search-feature { display: flex; align-items: flex-start; margin-top: 18rpx; padding: 17rpx 18rpx; border-radius: 16rpx; background: #fff7e9; }
.search-feature view text { display: block; }
.search-feature view text:first-child { color: #a56c34; font-size: 18rpx; font-weight: 700; }
.search-feature view text:last-child { margin-top: 6rpx; color: #765f48; font-size: 20rpx; line-height: 1.55; }

.coordinate-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 16rpx 18rpx; border: 1rpx dashed #cbdedd; border-radius: 15rpx; }
.coordinate-row view text { display: block; }
.coordinate-row view text:first-child { color: #8ba1a4; font-size: 17rpx; }
.coordinate-row view text:last-child { margin-top: 4rpx; color: #466c72; font-size: 20rpx; font-weight: 700; }
.copy-link { color: #087f88; font-size: 19rpx; font-weight: 700; }

.ai-plan-btn {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #f1dfbf;
  border-radius: 17rpx;
  background: linear-gradient(90deg, #fff8ea, #fffdf6);
  color: #b27435;
  font-size: 21rpx;
}

.ai-plan-btn text:first-child {
  margin-right: 9rpx;
  color: #e29a4a;
  font-size: 26rpx;
}

.ai-plan-arrow {
  margin-left: auto;
  color: #df9747;
  font-size: 28rpx;
}

.reason-icon {
  margin-right: 9rpx;
  color: #e69a47;
  font-size: 25rpx;
}

.tide-card {
  padding: 24rpx;
}

.tide-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tide-main, .tide-sub {
  display: block;
}

.tide-main {
  color: #e28f3f;
  font-size: 36rpx;
  font-weight: 800;
}

.tide-sub {
  margin-top: 6rpx;
  color: #91a7ac;
  font-size: 20rpx;
}

.tide-weather {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #6c8b91;
  font-size: 19rpx;
  line-height: 1.8;
}

.timeline {
  position: relative;
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 18rpx;
}

.timeline::before {
  position: absolute;
  top: 28rpx;
  right: 14rpx;
  left: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #d8eeee;
  content: '';
}

.timeline-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24%;
}

.time-dot {
  width: 20rpx;
  height: 20rpx;
  border: 5rpx solid #e5f4f3;
  border-radius: 50%;
  background: #45a89d;
}

.low .time-dot { background: #e29243; }
.high .time-dot { background: #6c8ed2; }

.time-label {
  margin-top: 12rpx;
  color: #294f57;
  font-size: 23rpx;
  font-weight: 700;
}

.time-name {
  margin-top: 6rpx;
  color: #8da3a8;
  font-size: 18rpx;
}

.time-height {
  margin-top: 4rpx;
  color: #b0bdc0;
  font-size: 17rpx;
}

.species-grid {
  display: flex;
  justify-content: space-between;
}

.species-card {
  width: 31.5%;
  padding: 20rpx 14rpx;
  text-align: center;
}

.species-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 12rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.species-mark.warm { background: #fff0d9; color: #df9341; }
.species-mark.cool { background: #eaf6f6; color: #419c99; }

.species-name {
  color: #4a6d73;
  font-size: 21rpx;
}

.species-value {
  margin-top: 7rpx;
  color: #dd8f3f;
  font-size: 23rpx;
  font-weight: 700;
}

.safety-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #f3dfbd;
  border-radius: 22rpx;
  background: #fff9ed;
}

.safety-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #a86d35;
  font-size: 25rpx;
  font-weight: 700;
}

.risk {
  padding: 6rpx 11rpx;
  border-radius: 99rpx;
  font-size: 18rpx;
  font-weight: 500;
}

.risk-low { background: #e7f6ee; color: #3a956f; }
.risk-medium { background: #fff0d4; color: #be7b33; }

.safety-text {
  margin-top: 13rpx;
  color: #876746;
  font-size: 22rpx;
  line-height: 1.6;
}

.safety-foot {
  margin-top: 12rpx;
  color: #b59a7b;
  font-size: 18rpx;
  line-height: 1.5;
}

.spot-feedback { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255,255,255,.16); color: #bde7df; font-size: 21rpx; text-align: center; }

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.detail-actions .ghost-btn, .detail-actions .primary-btn {
  flex: 1;
}

.detail-actions .ghost-btn.disabled { border-color: #e2e9e9; background: #f3f6f6; color: #93a3a6; }

/* 详情页按“去哪儿、几点去、有什么、安不安全”四步收敛 */
.detail-head-main { min-width: 0; padding-right: 20rpx; }
.decision-card { margin-top: 18rpx; padding: 24rpx; }
.decision-title { display: flex; align-items: center; color: #1b4b52; font-size: 28rpx; font-weight: 800; }
.decision-index { display: inline-flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 12rpx; border-radius: 12rpx; background: #168b85; color: #fff; font-size: 20rpx; }
.decision-index.warning { background: #e29243; }
.decision-title .zone-status, .decision-side, .confidence-link, .decision-title .risk { margin-left: auto; }
.decision-side { max-width: 48%; overflow: hidden; color: #e29243; font-size: 19rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.confidence-link { color: #719397; font-size: 18rpx; font-weight: 500; }
.decision-card .best-zone { margin-top: 18rpx; padding: 18rpx; }
.decision-card .best-zone-name { font-size: 27rpx; }
.key-answer { display: grid; grid-template-columns: 132rpx 1fr; gap: 12rpx; padding: 16rpx 2rpx; border-bottom: 1rpx solid #edf3f3; }
.key-answer > text:first-child { color: #849da1; font-size: 19rpx; }
.key-answer > text:last-child { color: #355e64; font-size: 21rpx; line-height: 1.5; }
.detail-toggle { margin-top: 16rpx; padding: 13rpx; border-radius: 13rpx; background: #f3f8f8; color: #197f80; font-size: 20rpx; text-align: center; }
.time-answer { margin-top: 20rpx; color: #e28f3f; font-size: 38rpx; font-weight: 800; }
.time-basis { margin-top: 8rpx; color: #718f94; font-size: 20rpx; line-height: 1.55; }
.weather-row { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 17rpx; padding: 15rpx 17rpx; border-radius: 14rpx; background: #f7faf9; color: #557b80; font-size: 19rpx; }
.source-note { margin-top: 18rpx; color: #8ba1a4; font-size: 18rpx; line-height: 1.55; }
.decision-card .catch-summary { margin: 17rpx 0 0; padding: 17rpx 18rpx; background: #fffaf2; }
.species-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 17rpx; }
.sea-intestine-inline { margin-top: 15rpx; padding: 16rpx 18rpx; border-radius: 15rpx; background: #eaf8f5; }
.sea-intestine-inline.blocked { background: #fff0e3; }
.sea-intestine-inline > view { display: flex; align-items: center; justify-content: space-between; color: #176e6b; font-size: 21rpx; font-weight: 800; }
.sea-intestine-inline > view text:last-child { color: #e18b3e; font-size: 34rpx; }
.sea-intestine-inline > text { display: block; margin-top: 7rpx; color: #648487; font-size: 18rpx; line-height: 1.5; }
.species-pill { display: flex; align-items: center; gap: 10rpx; padding: 11rpx 15rpx; border-radius: 99rpx; background: #edf7f5; }
.species-pill text:first-child { color: #2d6669; font-size: 20rpx; font-weight: 700; }
.species-pill text:last-child { color: #d9873b; font-size: 18rpx; }
.decision-card.safety-card { margin-top: 18rpx; background: #fff9ed; }
.decision-card .safety-text { display: grid; grid-template-columns: 92rpx 1fr; gap: 12rpx; }
.decision-card .safety-text text:first-child { color: #b17a43; font-size: 19rpx; font-weight: 700; }
.decision-card .safety-text text:last-child { color: #765b41; font-size: 21rpx; line-height: 1.55; }
.secondary-tools { margin-top: 18rpx; }
.secondary-tools .ai-plan-btn { margin-top: 0; }
.secondary-tools .spot-feedback { margin-top: 10rpx; padding: 15rpx; border: 0; color: #789497; }
