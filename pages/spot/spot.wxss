.spot-page { padding-top: 28rpx; padding-bottom: calc(158rpx + env(safe-area-inset-bottom)); }
.detail-head { margin-bottom: 24rpx; }
.detail-meta { color: #728d93; font-size: 24rpx; line-height: 1.5; }
.detail-title { margin-top: 12rpx; color: #173f48; font-size: 40rpx; font-weight: 800; line-height: 1.4; }
.detail-status { display: inline-block; margin-top: 14rpx; color: #806137; font-size: 24rpx; }
.time-card, .zone-card, .catch-card { margin-top: 18rpx; padding: 28rpx; box-shadow: none; }
.card-label { color: #728d93; font-size: 24rpx; }
.time-answer { margin-top: 12rpx; color: #126e73; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.best-zone-name { margin-top: 14rpx; color: #174b53; font-size: 31rpx; font-weight: 700; line-height: 1.5; }
.zone-status { margin-top: 10rpx; color: #98733e; font-size: 22rpx; line-height: 1.5; }
.arrival-guide { margin-top: 20rpx; color: #41696f; font-size: 25rpx; line-height: 1.65; }
.detail-toggle { margin-top: 20rpx; padding: 16rpx 0 4rpx; color: #27817f; font-size: 24rpx; line-height: 1.5; }
.expanded-content { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e5eeee; }
.detail-copy { margin-bottom: 14rpx; color: #41696f; font-size: 24rpx; line-height: 1.65; }
.timeline { display: flex; justify-content: space-between; gap: 16rpx; margin: 22rpx 0; }
.timeline-item text { display: block; color: #285e62; font-size: 25rpx; }
.timeline-item text:last-child { margin-top: 8rpx; color: #789196; font-size: 22rpx; }
.source-note { margin-top: 14rpx; color: #728d93; font-size: 22rpx; line-height: 1.65; }
.route-step { display: flex; gap: 20rpx; margin: 18rpx 0; }
.route-step > text:first-child { flex: 0 0 100rpx; color: #728d93; font-size: 23rpx; }
.route-step > text:last-child { color: #315e64; font-size: 24rpx; line-height: 1.65; }
.coordinate-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18rpx; margin-top: 24rpx; padding: 20rpx 0; border-top: 1rpx solid #e5eeee; color: #27817f; font-size: 22rpx; }
.catch-summary { margin-top: 14rpx; color: #315e64; font-size: 26rpx; line-height: 1.65; }
.sea-intestine-summary { margin-top: 14rpx; color: #846336; font-size: 24rpx; line-height: 1.6; }
.species-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.species-pill { padding: 12rpx 16rpx; border-radius: 14rpx; background: #eff7f5; color: #41696f; font-size: 23rpx; }
.safety-note, .urgent-note { margin-top: 20rpx; padding: 24rpx; border-radius: 20rpx; background: #fff3e2; color: #825c32; }
.safety-note > view, .urgent-note > view:first-child { font-size: 26rpx; font-weight: 700; line-height: 1.5; }
.safety-note > text, .urgent-note > view:last-child:not(:first-child) { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.65; }
.safety-note > text:last-child { font-size: 22rpx; }
.more-tools { padding: 28rpx 0 8rpx; color: #528084; font-size: 24rpx; text-align: center; }
.detail-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 18rpx; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: #f4f8fa; border-top: 1rpx solid #dceaea; }
.detail-actions .ghost-btn { flex: 0 0 196rpx; height: 86rpx; }
.detail-actions .primary-btn { flex: 1; }
.detail-loading { color: #789196; font-size: 26rpx; text-align: center; }
.detail-loading .ghost-btn { margin-top: 28rpx; }
