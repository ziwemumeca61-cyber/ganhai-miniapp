<view wx:if="{{spot}}" class="page-shell spot-page">
  <view class="detail-head">
    <view>
      <view class="eyebrow">{{spot.area}} · 今日赶海点</view>
      <view class="detail-title">{{spot.name}}</view>
      <view class="detail-meta"><text>距当前位置约 {{spot.distance}} km</text><text class="meta-dot">·</text><text>{{spot.update}}</text></view>
    </view>
    <view class="detail-score"><text>{{spot.safetyScore === null ? '--' : spot.safetyScore}}</text><text>海况安全分</text></view>
  </view>

  <view class="zone-card card">
    <view class="zone-header"><view><text class="zone-kicker">VERIFIED SHORE GUIDE</text><text class="zone-title">{{spot.verification}}</text></view><view class="compass"><text>N</text><text class="compass-arrow">↑</text><text>E</text></view></view>
    <view class="position-facts">
      <view class="position-fact"><text>具体方位</text><text>{{spot.shoreSide}}</text></view>
      <view class="position-fact"><text>离岸范围</text><text>{{spot.offshoreRange}}</text></view>
    </view>
    <view class="zone-map">
      <view class="shoreline"><text>岸线</text></view>
      <view class="zone-water"><view class="zone-strip one"></view><view class="zone-strip two"></view><view class="zone-strip three"></view><text class="water-label">{{spot.offshoreRange}}</text></view>
      <view class="distance-label start">入口</view>
      <view class="distance-label end">目标近岸带</view>
    </view>
    <view class="zone-reason"><text class="reason-icon">✦</text><text>入口：{{spot.entry}}　岸段：{{spot.shoreline}}</text></view>
    <view class="ai-plan-btn" bindtap="askAI"><text>✦</text><text>让 AI 按有效数据说明安全与收获</text><text class="ai-plan-arrow">→</text></view>
  </view>

  <view class="section-title"><text class="title">今天的潮汐节奏</text><text class="link">{{spot.tideRange}}</text></view>
  <view class="tide-card card">
    <view class="tide-top"><view><text class="tide-main">{{spot.bestWindow}}</text><text class="tide-sub">{{spot.windowBasis}}</text></view><view class="tide-weather"><text>☼ {{spot.weather}}</text><text>潮汐 {{spot.tide}}</text></view></view>
    <view class="timeline">
      <view wx:for="{{forecast}}" wx:key="time" class="timeline-item {{item.type}}">
        <view class="time-dot"></view>
        <view class="time-label">{{item.time}}</view>
        <view class="time-name">{{item.label}}</view>
        <view class="time-height">{{item.height}}</view>
      </view>
    </view>
  </view>

  <view class="section-title"><text class="title">近14天收获判断</text><text class="link" bindtap="showDisclaimer">置信说明 ⓘ</text></view>
  <view class="catch-summary card">{{spot.catchForecast}}</view>
  <view class="species-grid">
      <view wx:for="{{spot.species}}" wx:key="name" class="species-card card">
      <view class="species-mark {{item.tone}}">{{item.mark}}</view>
      <view class="species-name">{{item.name}}</view>
      <view class="species-value">{{item.value}}</view>
    </view>
  </view>

  <view class="safety-card">
    <view class="safety-title"><text>安全提醒</text><text class="risk {{spot.risk === '低' ? 'risk-low' : 'risk-medium'}}">{{spot.risk}}风险</text></view>
    <view class="safety-text">撤离：{{spot.retreat}}</view>
    <view class="safety-foot">方位和离岸距离为保守参考带，并非测绘边界；潮位变化、岸段封闭或现场警戒时，以现场管理提示优先。{{spot.modelNotice ? "　" + spot.modelNotice + "；数据：Open-Meteo（CC BY 4.0）。" : ""}}</view>
  </view>

  <view class="detail-actions">
    <view class="ghost-btn" bindtap="goReport">上报战果</view>
    <view class="primary-btn" bindtap="openLocation">打开导航</view>
  </view>
</view>
