<view wx:if="{{spot}}" class="page-shell spot-page">
  <view class="detail-head">
    <view class="detail-meta">{{spot.area}} · {{spot.distanceLabel}}</view>
    <view class="detail-title">{{spot.name}}</view>
    <view class="detail-status">{{spot.canReport ? (spot.conditionsBlocked ? '当前不建议下滩' : spot.safetyScore === null ? '海况待更新' : '海况安全参考 ' + spot.safetyScore + '分') : '仅观察，不采集'}}</view>
  </view>

  <view wx:if="{{spot.conditionsBlocked || !spot.conditionsReady}}" class="urgent-note">
    <view>{{spot.conditionsBlocked ? '当前不建议下滩' : '实时海况不足，暂不能判断是否适合下滩'}}</view>
    <view wx:if="{{spot.conditionsBlocked}}"><text wx:for="{{spot.conditionsReasons}}" wx:key="*this">{{item}} </text></view>
  </view>

  <view class="time-card card">
    <view class="card-label">参考时段</view>
    <view class="time-answer">{{spot.bestWindow}}</view>
    <view class="detail-toggle" bindtap="toggleTide">{{showTideDetails ? '收起潮汐依据 ⌃' : '查看潮汐依据 ⌄'}}</view>
    <view wx:if="{{showTideDetails}}" class="expanded-content">
      <view class="detail-copy">{{spot.windowBasis}} · {{spot.tide}}</view>
      <view class="detail-copy">{{spot.weather}} · {{spot.tideRange}}</view>
      <view class="timeline">
        <view wx:for="{{forecast}}" wx:key="time" class="timeline-item"><text>{{item.time}}</text><text>{{item.label}}</text></view>
      </view>
      <view class="source-note">{{spot.tideSource}}{{spot.tideStation ? ' · ' + spot.tideStation : ''}} · {{spot.tideConfidence}}置信{{spot.stationDistanceKm !== null ? ' · 距潮汐站约' + spot.stationDistanceKm + 'km' : ''}}</view>
    </view>
  </view>

  <view class="zone-card card">
    <view class="card-label">到哪一段</view>
    <view class="best-zone-name">{{spot.bestZone}}</view>
    <view class="zone-status">{{spot.zoneStatus}} · {{spot.bestZoneSource}}</view>
    <view class="arrival-guide">{{spot.shoreSide}}</view>
    <view class="detail-toggle" bindtap="toggleRoute">{{showRouteDetails ? '收起到达路线 ⌃' : '查看路线与现场特征 ⌄'}}</view>
    <view wx:if="{{showRouteDetails}}" class="expanded-content">
      <view wx:for="{{spot.zoneSteps}}" wx:key="label" class="route-step"><text>{{item.label}}</text><text>{{item.text}}</text></view>
      <view wx:if="{{spot.bestZoneDetail}}" class="source-note">{{spot.bestZoneDetail}}</view>
      <view class="source-note">岸段样本：{{spot.zoneEvidenceText}}</view>
      <view class="coordinate-row" bindtap="copyZoneGuide"><text>参考坐标 {{spot.coordinateLabel}}</text><text>复制路线</text></view>
      <view class="source-note">导航到附近参考点；入口与开放范围以现场为准。</view>
    </view>
  </view>

  <view class="catch-card card">
    <view class="card-label">可能遇到</view>
    <view class="catch-summary">{{spot.catchForecast}}</view>
    <view wx:if="{{spot.seaIntestineForecast.available}}" class="sea-intestine-summary">{{spot.seaIntestineForecast.safetyBlocked ? '当前不建议下滩 · ' : ''}}海肠：{{spot.seaIntestineForecast.summary}}</view>
    <view class="detail-toggle" bindtap="toggleCatch">{{showCatchDetails ? '收起样本与预测依据 ⌃' : '查看样本与预测依据 ⌄'}}</view>
    <view wx:if="{{showCatchDetails}}" class="expanded-content">
      <view class="detail-copy">近14天 {{spot.sampleCount}} 条现场样本 · {{spot.confidence}}置信</view>
      <view class="species-row"><view wx:for="{{spot.species}}" wx:key="name" class="species-pill">{{item.name}} · {{item.value}}</view></view>
      <view wx:if="{{spot.seaIntestineForecast.available}}" class="source-note">海肠冲岸参考 {{spot.seaIntestineForecast.score}} · 发现 {{spot.seaIntestineForecast.positiveCount}} 次 / 未发现 {{spot.seaIntestineForecast.negativeCount}} 次。{{spot.seaIntestineForecast.disclaimer}}</view>
      <view class="detail-toggle" bindtap="showDisclaimer">如何理解样本与置信度 ⓘ</view>
    </view>
  </view>

  <view class="safety-note"><view>撤离提醒</view><text>{{spot.retreat}}</text><text>避开被海水包围的礁石和沟槽；封闭、预警或风浪增大时立即撤离。</text></view>
  <view class="more-tools" bindtap="showMoreActions">{{feedbackSubmitting ? '正在提交反馈…' : '数据说明与地点反馈 ›'}}</view>

  <view class="detail-actions">
    <view wx:if="{{spot.canReport}}" class="ghost-btn" bindtap="goReport">贡献样本</view>
    <view class="primary-btn" bindtap="openLocation">导航到附近</view>
  </view>
</view>
<view wx:else class="page-shell detail-loading"><text>{{loadFailed ? '地点数据暂未加载' : '正在读取地点…'}}</text><view wx:if="{{loadFailed}}" class="ghost-btn" bindtap="retryLoad">重新加载</view></view>
