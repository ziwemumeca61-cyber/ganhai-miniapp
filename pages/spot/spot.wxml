<view wx:if="{{spot}}" class="page-shell spot-page">
  <view class="detail-head">
    <view>
      <view class="eyebrow">{{spot.area}} · {{spot.canReport ? '今日赶海点' : '生态观察点'}}</view>
      <view class="detail-title">{{spot.name}}</view>
      <view class="detail-meta"><text>{{spot.distanceLabel}}</text><text class="meta-dot">·</text><text>{{spot.update}}</text></view>
    </view>
    <view class="detail-score"><text>{{spot.safetyScore === null ? '--' : spot.safetyScore}}</text><text>海况安全分</text></view>
  </view>

  <view class="zone-card card">
    <view class="zone-header"><view><text class="zone-kicker">PRIORITY SHORE ZONE</text><text class="zone-title">优先赶海区</text></view><view class="zone-status {{spot.bestZoneAvailable ? 'ready' : 'pending'}}">{{spot.zoneStatus}}</view></view>
    <view class="best-zone {{spot.bestZoneAvailable ? '' : 'pending'}}">
      <text class="best-zone-label">具体去哪一段</text>
      <text class="best-zone-name">{{spot.bestZone}}</text>
      <text class="best-zone-source">地点定位：{{spot.verification}}</text>
      <text class="best-zone-note">{{!spot.canReport ? '该地点只作生态观察，不提供采集位置。' : spot.bestZoneAvailable ? '这是岸段参考，不代表开放许可；到场先看围挡、旗语和管理提示。' : '这个地点目前只能导航到附近，不能负责任地编造一段“最佳位置”。'}}</text>
    </view>
    <view class="zone-route">
      <view wx:for="{{spot.zoneSteps}}" wx:key="label" class="route-step">
        <view class="route-index">{{index + 1}}</view>
        <view class="route-copy"><text>{{item.label}}</text><text>{{item.text}}</text></view>
      </view>
    </view>
    <view class="search-feature"><text class="reason-icon">✦</text><view><text>现场识别特征</text><text>{{spot.searchFeature}}</text></view></view>
    <view class="coordinate-row" bindtap="copyZoneGuide"><view><text>导航参考坐标</text><text>{{spot.coordinateLabel}}</text></view><text class="copy-link">复制路线</text></view>
    <view class="ai-plan-btn" bindtap="askAI"><text>✦</text><text>让 AI 按有效数据说明安全与收获</text><text class="ai-plan-arrow">→</text></view>
  </view>

  <view class="section-title"><text class="title">今天的潮汐节奏</text><text class="link">{{spot.tideRange}}</text></view>
  <view class="tide-card card">
    <view class="tide-top"><view><text class="tide-main">{{spot.bestWindow}}</text><text class="tide-sub">{{spot.windowBasis}}</text><text class="tide-sub">{{spot.tideSource}}{{spot.tideStation ? " · " + spot.tideStation : ""}} · {{spot.tideConfidence}}置信{{spot.stationDistanceKm !== null ? " · 距潮汐站约" + spot.stationDistanceKm + "km" : ""}}</text></view><view class="tide-weather"><text>☼ {{spot.weather}}</text><text>潮汐 {{spot.tide}}</text></view></view>
    <view class="timeline">
      <view wx:for="{{forecast}}" wx:key="time" class="timeline-item {{item.type}}">
        <view class="time-dot"></view>
        <view class="time-label">{{item.time}}</view>
        <view class="time-name">{{item.label}}</view>
        <view class="time-height">{{item.height}}</view>
      </view>
    </view>
  </view>

  <view class="section-title"><text class="title">近14天收获判断</text><text class="link" bindtap="showDisclaimer">置信说明 ⓘ</text></view>
  <view class="catch-summary card">{{spot.catchForecast}}</view>
  <view class="species-grid">
      <view wx:for="{{spot.species}}" wx:key="name" class="species-card card">
      <view class="species-mark {{item.tone}}">{{item.mark}}</view>
      <view class="species-name">{{item.name}}</view>
      <view class="species-value">{{item.value}}</view>
    </view>
  </view>

  <view class="safety-card">
    <view class="safety-title"><text>安全提醒</text><text class="risk {{spot.risk === '低' ? 'risk-low' : 'risk-medium'}}">{{spot.risk}}风险</text></view>
    <view class="safety-text">撤离：{{spot.retreat}}</view>
    <view class="safety-foot">方位和离岸距离为保守参考带，并非测绘边界；潮位变化、岸段封闭或现场警戒时，以现场管理提示优先。{{spot.modelNotice ? "　" + spot.modelNotice + "；数据：Open-Meteo（CC BY 4.0）。" : ""}}</view>
    <view class="spot-feedback" bindtap="showFeedback">{{feedbackSubmitting ? '正在提交…' : '位置、入口、优先赶海区或采集规定有误？点这里反馈'}}</view>
  </view>

  <view class="detail-actions">
    <view wx:if="{{spot.canReport}}" class="ghost-btn" bindtap="goReport">上报战果</view>
    <view wx:else class="ghost-btn disabled">仅观察，不采集</view>
    <view class="primary-btn" bindtap="openLocation">导航到参考点</view>
  </view>
</view>
