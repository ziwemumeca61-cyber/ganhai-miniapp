.home-page { padding-top: 30rpx; }
.topline { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 28rpx; }
.brand { color: #0a6873; font-size: 40rpx; font-weight: 800; }
.location-chip { padding: 16rpx 22rpx; border-radius: 99rpx; background: #fff; color: #28545b; font-size: 26rpx; }
.hero { padding: 30rpx; background: #0b7780; color: #fff; }
.hero-label { color: #d1e8e7; font-size: 23rpx; line-height: 1.6; }
.hero-title { margin: 14rpx 0 20rpx; font-size: 36rpx; font-weight: 700; line-height: 1.35; }
.hero-window { margin-bottom: 4rpx; color: #ffe1aa; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.hero-detail { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.18); color: #fff; font-size: 25rpx; }
.safety-banner { display: flex; gap: 14rpx; margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: #fff1df; color: #89551f; }
.safety-banner > text { flex-shrink: 0; font-size: 29rpx; font-weight: 800; }
.safety-banner view text { display: block; font-size: 25rpx; font-weight: 600; }
.safety-banner view text:last-child { margin-top: 8rpx; font-size: 23rpx; font-weight: 400; line-height: 1.6; }
.browse-tools { display: flex; justify-content: space-between; margin: 18rpx 0 8rpx; }
.browse-tools view { padding: 20rpx 8rpx; color: #39777b; font-size: 25rpx; }
.section-title { gap: 16rpx; margin: 24rpx 0 18rpx; }
.section-title .title { font-size: 30rpx; }
.list-hint { color: #789196; font-size: 21rpx; }
.spot-card { margin-bottom: 16rpx; padding: 26rpx; box-shadow: none; }
.spot-top { display: flex; align-items: flex-start; gap: 20rpx; }
.spot-main { flex: 1; min-width: 0; }
.spot-name { color: #1e4650; font-size: 30rpx; font-weight: 700; line-height: 1.45; }
.spot-meta { margin-top: 10rpx; color: #728e93; font-size: 23rpx; line-height: 1.5; }
.spot-score { flex-shrink: 0; max-width: 180rpx; padding-top: 5rpx; color: #9b6c32; font-size: 22rpx; line-height: 1.5; }
.spot-window { margin-top: 20rpx; color: #285e62; font-size: 27rpx; font-weight: 600; }
.spot-direction { display: flex; gap: 18rpx; justify-content: space-between; margin-top: 12rpx; color: #728e93; font-size: 23rpx; line-height: 1.5; }
.spot-direction > text { margin-left: auto; font-size: 28rpx; color: #408781; }
.more-spots, .list-state { padding: 26rpx 0; color: #39777b; font-size: 25rpx; text-align: center; }
.data-notice { padding: 28rpx 0 12rpx; color: #789196; font-size: 21rpx; text-align: center; }
