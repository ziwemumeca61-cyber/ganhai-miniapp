<view class="page-shell home-page">
  <view class="topline">
    <view class="brand">赶海雷达</view>
    <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="chooseCity"><view class="location-chip">{{cityName}} ⌄</view></picker>
  </view>
  <view class="hero card">
    <block wx:if="{{loading}}"><view class="hero-label">今日海况</view><view class="hero-title">正在更新…</view></block>
    <block wx:else>
      <view class="hero-label">{{summary.referenceSpot ? '优先参考 · ' + summary.referenceSpot : cityName + ' · 今日海况'}}</view>
      <view class="hero-title">{{summary.safetyLevel || summary.label}}</view>
      <view class="hero-window">{{summary.bestTime}}</view>
      <view class="hero-label">参考赶海时段 · 以地点详情为准</view>
      <view wx:if="{{spots.length}}" class="hero-detail" bindtap="viewSpot" data-id="{{spots[0].id}}">查看地点与岸段 ›</view>
    </block>
  </view>
  <view wx:if="{{!loading && summary.showSafetyWarning}}" class="safety-banner"><text>!</text><view><text>{{summary.warningTitle}}</text><text>{{summary.warningText}}</text></view></view>
  <view class="browse-tools">
    <view bindtap="goMap">看地图</view>
    <view bindtap="goGuide">按条件筛选</view>
    <view bindtap="locate">重新定位</view>
  </view>
  <view class="section-title"><text class="title">{{cityName}}赶海点</text><text class="list-hint">距离与海况综合排序</text></view>
  <view wx:if="{{loading}}" class="list-state">正在整理本市地点…</view>
  <view wx:elif="{{!spots.length}}" class="list-state">当前城市暂无收录地点</view>
  <block wx:else>
    <view wx:for="{{visibleSpots}}" wx:key="id" class="spot-card card" bindtap="viewSpot" data-id="{{item.id}}">
      <view class="spot-top">
        <view class="spot-main"><view class="spot-name">{{item.name}}</view><view class="spot-meta">{{item.area}} · {{item.distanceLabel}}</view></view>
        <view class="spot-score"><text>{{item.conditionsBlocked ? '暂勿下滩' : item.safetyScore === null ? '海况待更新' : '安全 ' + item.safetyScore + '分'}}</text></view>
      </view>
      <view class="spot-window">{{item.bestWindow}}</view>
      <view class="spot-direction">{{!item.canReport ? '仅观察，不采集' : item.bestZoneAvailable ? '参考岸段：' + item.bestZone : '具体岸段待确认'}} <text>›</text></view>
    </view>
    <view wx:if="{{visibleSpots.length < spots.length}}" class="more-spots" bindtap="showMoreSpots">查看更多地点（还剩 {{spots.length - visibleSpots.length}} 个）⌄</view>
  </block>
  <view class="data-notice" bindtap="showDataInfo">Open-Meteo · 数据来源与更新时间 ⓘ</view>
</view>
