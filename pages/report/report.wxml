<view class="page-shell report-page">
  <block wx:if="{{mode === 'circle'}}">
    <view class="circle-head">
      <view class="report-title">赶海圈</view>
      <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="chooseCity"><view class="city-picker">{{cityName}} ⌄</view></picker>
    </view>
    <view class="circle-toolbar"><text>海友的海边日常</text><view class="publish-btn" bindtap="openOfficialPublisher">发一条</view></view>
    <view class="official-card card">
      <view wx:if="{{!officialPublishEnabled}}" class="official-unavailable">请在 Android 或 iPhone 微信中查看和发布</view>
      <official-account-publish wx:elif="{{officialFeedMounted}}" topic="{{circleTopic}}" limit="10" placeholder="分享今天的海边见闻和赶海收获…" background-color="#f6f1e6" color-unity="{{true}}" show-related="{{true}}" recommend-path="/pages/report/report" recommend-title="查看赶海现场" binderror="onOfficialComponentError" bindpublishsuccess="onOfficialPublishSuccess" bindpublishfail="onOfficialPublishFail"></official-account-publish>
      <view wx:else class="official-unavailable">正在刷新…</view>
    </view>
    <view class="sample-entry" bindtap="openSample">贡献匿名现场样本，帮助校准预测 ›</view>
  </block>
  <block wx:else>
    <view class="back-link" bindtap="backToCircle">‹ 返回赶海圈</view>
    <view class="report-title">给海边记一笔</view>
    <view class="report-subtitle">发现了什么，或什么也没找到，都能帮助校准预测。</view>
    <view class="report-card card">
      <view class="form-label">地点</view>
      <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="chooseCity"><view class="city-form-picker"><text>城市</text><text>{{cityName}} ⌄</text></view></picker>
      <picker wx:if="{{spotOptions.length}}" mode="selector" range="{{spotOptions}}" range-key="name" value="{{spotIndex}}" bindchange="chooseSpot"><view class="spot-picker"><text>{{spotName}}</text><text>⌄</text></view></picker>
      <view wx:else class="spot-picker">{{spotName}}</view>
      <view class="form-label amount-label">所在岸段</view>
      <view class="chip-grid"><view wx:for="{{zoneOptions}}" wx:key="id" class="choice-chip {{zoneId === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="chooseZone">{{item.label}}</view></view>
      <view class="form-label amount-label">品类</view>
      <view class="chip-grid"><view wx:for="{{species}}" wx:key="*this" class="choice-chip {{selectedSpecies === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseSpecies">{{item}}</view></view>
      <view class="form-label amount-label">现场结果</view>
      <view class="chip-grid"><view class="choice-chip {{found ? 'selected' : ''}}" data-value="true" bindtap="chooseFound">发现了</view><view class="choice-chip {{!found ? 'selected' : ''}}" data-value="false" bindtap="chooseFound">没有发现</view></view>
      <block wx:if="{{found}}"><view class="form-label amount-label">收获量</view><view class="chip-grid"><view wx:for="{{amounts}}" wx:key="*this" class="choice-chip {{amount === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseAmount">{{item}}</view></view></block>
    </view>
    <view class="location-check {{onsiteReady ? 'ready' : ''}}" bindtap="verifyLocation"><text>{{onsiteReady ? '位置已获取' : '获取现场位置'}}</text><text>{{locationText}}</text></view>
    <view class="privacy-note">精确坐标仅用于当次核验，不保存。</view>
    <view class="primary-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '正在提交…' : '贡献匿名样本'}}</view>
  </block>
</view>
