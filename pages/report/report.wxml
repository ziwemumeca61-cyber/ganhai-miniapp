<view class="page-shell report-page">
  <view class="report-head">
    <view class="eyebrow">FIELD NOTES · {{spotName}}</view>
    <view class="report-title">把今天的海，告诉下一位赶海人</view>
    <view class="report-subtitle">真实战果会帮助我们校准不同地点、潮位和季节的预测。</view>
  </view>

  <view class="report-card card">
    <view class="form-label">今天遇到的品类</view>
    <view class="chip-grid">
      <view wx:for="{{species}}" wx:key="*this" class="choice-chip {{selectedSpecies === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseSpecies">{{item}}</view>
    </view>

    <view class="form-label amount-label">大概收获</view>
    <view class="amount-row">
      <view wx:for="{{amounts}}" wx:key="*this" class="amount-choice {{amount === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseAmount"><text class="amount-dot"></text><text>{{item}}</text></view>
    </view>

    <view class="form-label note-label">补充一句（可选）</view>
    <textarea class="note-input" maxlength="120" placeholder="例如：东侧礁石缝里海螺明显多一些" value="{{note}}" bindinput="onNote"></textarea>

    <view class="photo-line" bindtap="addPhoto"><view class="photo-icon">＋</view><view><text class="photo-title">上传现场照片</text><text class="photo-tip">{{imageCount ? '已选择 ' + imageCount + ' 张' : '照片越清晰，校准越准确'}}</text></view><text class="photo-arrow">›</text></view>
  </view>

  <view class="privacy-note">仅用于赶海点数据校准，不公开你的精确个人位置。</view>
  <view class="primary-btn submit-btn" bindtap="submit">提交这次战果</view>
  <view wx:if="{{submitted}}" class="submitted-note">已保存到本机演示记录，接入云开发后将同步到赶海点模型。</view>
</view>
