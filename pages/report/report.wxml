<view class="page-shell report-page">
  <block wx:if="{{mode === 'feed'}}">
    <view class="circle-head">
      <view>
        <view class="eyebrow">GANHAI COMMUNITY</view>
        <view class="report-title">赶海圈</view>
        <view class="report-subtitle">看看{{cityName}}海友分享的真实收获。</view>
      </view>
      <view class="publish-btn" bindtap="openPublish">＋ 发布战果</view>
    </view>

    <view class="feed-city-row"><text>当前城市</text><picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="chooseCity"><view class="city-picker">{{cityName}}⌄</view></picker></view>
    <view class="circle-rule">发布时只核验你是否在所选地点附近，精确坐标不会保存或展示；核验动态将计入真实收获样本。</view>

    <view wx:if="{{feedLoading && !feedLoaded}}" class="feed-state">正在读取赶海圈…</view>
    <view wx:elif="{{feedLoaded && !feed.length}}" class="empty-card card">
      <view class="empty-icon">≈</view>
      <view class="empty-title">还没有现场分享</view>
      <view class="empty-text">还没有海友分享，来发布第一条真实收获吧。</view>
      <view class="empty-action" bindtap="openPublish">发布第一条</view>
    </view>

    <view class="feed-list" wx:else>
      <view wx:for="{{feed}}" wx:key="id" class="feed-card card">
        <view class="feed-top">
          <view class="feed-avatar">{{item.species.slice(0, 1)}}</view>
          <view class="feed-meta">
            <view class="feed-spot">{{item.spotName}}</view>
            <view class="feed-time">{{item.timeLabel}} · {{item.verified ? '现场定位已核验' : '用户自选地点'}}</view>
          </view>
          <view class="verified-badge">{{item.verified ? '可信现场' : '海友分享'}}</view>
        </view>
        <view class="feed-result"><text class="species-name">{{item.species}}</text><text class="amount-tag">{{item.amount}}</text></view>
        <view class="feed-note">{{item.noteDisplay}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="publish-head">
      <view class="back-link" bindtap="backToFeed">‹ 返回赶海圈</view>
      <view class="report-title">分享今天的现场</view>
      <view class="report-subtitle">完成现场定位核验后，动态会计入该地点的真实收获样本。</view>
    </view>

    <view class="location-check {{onsiteReady ? 'ready' : ''}}" bindtap="verifyLocation">
      <view class="location-check-icon">○</view>
      <view><text class="location-check-title">{{onsiteReady ? '现场位置已获取' : '核验当前位置'}}</text><text class="location-check-text">{{locationText}}</text></view>
    </view>

    <view class="report-card card">
      <view class="form-label">赶海地点</view>
      <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="chooseCity">
        <view class="city-form-picker"><text>城市</text><text>{{cityName}}⌄</text></view>
      </picker>
      <picker wx:if="{{spotOptions.length}}" mode="selector" range="{{spotOptions}}" range-key="name" value="{{spotIndex}}" bindchange="chooseSpot">
        <view class="spot-picker"><text>{{spotName}}</text><text>⌄</text></view>
      </picker>
      <view wx:else class="spot-picker empty"><text>{{spotName}}</text></view>
      <view class="form-hint">{{spotOptions.length ? '已收录的附近参考点也可选择；请确保分享内容与所选地点一致。' : '生态观察或禁止采集地点不开放战果上报。'}}</view>

      <view class="form-label amount-label">今天遇到的品类</view>
      <view class="chip-grid"><view wx:for="{{species}}" wx:key="*this" class="choice-chip {{selectedSpecies === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseSpecies">{{item}}</view></view>

      <view class="form-label amount-label">大概收获</view>
      <view class="amount-row"><view wx:for="{{amounts}}" wx:key="*this" class="amount-choice {{amount === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseAmount"><text class="amount-dot"></text><text>{{item}}</text></view></view>

      <view class="note-head"><view class="form-label note-label">补充一句（可选）</view><view class="ai-draft-btn {{aiGenerating ? 'disabled' : ''}}" bindtap="generateDraft">✦ {{aiGenerating ? '整理中' : 'AI帮我整理'}}</view></view>
      <textarea class="note-input" maxlength="120" placeholder="例如：公共入口附近沙滩，回涨前已撤离" value="{{note}}" bindinput="onNote"></textarea>
    </view>

    <view class="privacy-note">定位坐标仅在发布时用于计算与地点的距离，云端不保存精确经纬度，也不会向其他用户展示。</view>
    <view class="primary-btn submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '正在发布…' : '发布到赶海圈'}}</view>
  </block>
</view>
