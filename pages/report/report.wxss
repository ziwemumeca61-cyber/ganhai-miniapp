.report-page {
  padding-top: 32rpx;
}

.report-title {
  max-width: 620rpx;
  margin-top: 13rpx;
  color: #173f48;
  font-size: 43rpx;
  font-weight: 800;
  line-height: 1.25;
}

.report-subtitle {
  margin-top: 12rpx;
  color: #7e979d;
  font-size: 22rpx;
  line-height: 1.6;
}

.report-card {
  margin-top: 30rpx;
  padding: 26rpx 22rpx;
}

.form-label {
  color: #335c64;
  font-size: 25rpx;
  font-weight: 700;
}

.amount-label, .note-label {
  margin-top: 34rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.choice-chip {
  padding: 13rpx 20rpx;
  border: 1rpx solid #e0eded;
  border-radius: 16rpx;
  background: #f8fbfb;
  color: #6d888e;
  font-size: 22rpx;
}

.choice-chip.selected {
  border-color: #68b8b0;
  background: #eaf8f5;
  color: #087f88;
  font-weight: 600;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.amount-choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8ca1a5;
  font-size: 20rpx;
}

.amount-dot {
  width: 26rpx;
  height: 26rpx;
  margin-bottom: 10rpx;
  border: 5rpx solid #e4efef;
  border-radius: 50%;
  background: #c5d9da;
}

.amount-choice.selected {
  color: #d78c3f;
  font-weight: 600;
}

.amount-choice.selected .amount-dot {
  border-color: #ffedcf;
  background: #e59a4b;
}

.note-input {
  width: 100%;
  height: 150rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e2eded;
  border-radius: 16rpx;
  background: #f9fbfb;
  color: #41636a;
  font-size: 22rpx;
}

.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-draft-btn {
  margin-top: 34rpx;
  padding: 8rpx 13rpx;
  border: 1rpx solid #f0dbb9;
  border-radius: 99rpx;
  background: #fff8eb;
  color: #b87939;
  font-size: 18rpx;
}

.ai-draft-btn.disabled {
  opacity: .55;
}

.photo-line {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf3f3;
}

.photo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  background: #edf8f6;
  color: #49a89d;
  font-size: 40rpx;
  font-weight: 300;
}

.photo-title, .photo-tip {
  display: block;
}

.photo-title {
  color: #456971;
  font-size: 23rpx;
  font-weight: 600;
}

.photo-tip {
  margin-top: 5rpx;
  color: #9bafb3;
  font-size: 18rpx;
}

.photo-arrow {
  margin-left: auto;
  color: #9ab1b4;
  font-size: 36rpx;
}

.privacy-note {
  margin: 20rpx 8rpx;
  color: #9baeb2;
  font-size: 18rpx;
  text-align: center;
}

.submit-btn {
  margin-top: 14rpx;
}

.submitted-note {
  margin-top: 20rpx;
  color: #4b9c91;
  font-size: 20rpx;
  text-align: center;
}
