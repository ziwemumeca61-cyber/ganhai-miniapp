.report-page {
  padding-top: 32rpx;
}

.report-title {
  max-width: 620rpx;
  margin-top: 13rpx;
  color: #173f48;
  font-size: 43rpx;
  font-weight: 800;
  line-height: 1.25;
}

.report-subtitle {
  margin-top: 12rpx;
  color: #7e979d;
  font-size: 22rpx;
  line-height: 1.6;
}

.circle-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.publish-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: #087f88;
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(8, 127, 136, .18);
}

.circle-rule {
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dcebea;
  border-radius: 18rpx;
  background: #f1f8f7;
  color: #6e898e;
  font-size: 19rpx;
  line-height: 1.55;
}

.feed-city-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #fff; color: #789196; font-size: 21rpx; }
.city-picker { padding: 8rpx 14rpx; border-radius: 99rpx; background: #eaf7f4; color: #087f88; font-weight: 700; }
.city-form-picker { display: flex; justify-content: space-between; margin-top: 16rpx; padding: 15rpx 18rpx; border: 1rpx solid #e4eeee; border-radius: 16rpx; color: #6f888d; font-size: 21rpx; }
.city-form-picker text:last-child { color: #087f88; font-weight: 700; }

.feed-list {
  margin-top: 24rpx;
}

.feed-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.feed-top {
  display: flex;
  align-items: center;
}

.feed-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 15rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #dff5f1, #fff0d7);
  color: #087f88;
  font-size: 28rpx;
  font-weight: 800;
}

.feed-meta {
  min-width: 0;
}

.feed-spot {
  overflow: hidden;
  color: #315a62;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-time {
  margin-top: 6rpx;
  color: #98aaae;
  font-size: 17rpx;
}

.verified-badge {
  flex-shrink: 0;
  margin-left: auto;
  padding: 7rpx 11rpx;
  border-radius: 99rpx;
  background: #e8f7f2;
  color: #258a78;
  font-size: 16rpx;
  font-weight: 700;
}

.feed-result {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.species-name {
  color: #173f48;
  font-size: 31rpx;
  font-weight: 800;
}

.amount-tag {
  margin-left: 13rpx;
  padding: 6rpx 12rpx;
  border-radius: 99rpx;
  background: #fff2dc;
  color: #bc7936;
  font-size: 18rpx;
  font-weight: 700;
}

.feed-note {
  margin-top: 14rpx;
  color: #617d83;
  font-size: 22rpx;
  line-height: 1.65;
}

.feed-state {
  padding: 100rpx 0;
  color: #91a5aa;
  font-size: 22rpx;
  text-align: center;
}

.empty-card {
  margin-top: 32rpx;
  padding: 58rpx 30rpx;
  text-align: center;
}

.empty-icon {
  color: #54a79d;
  font-size: 60rpx;
}

.empty-title {
  margin-top: 12rpx;
  color: #315a62;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 12rpx;
  color: #8ba0a5;
  font-size: 20rpx;
  line-height: 1.6;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 99rpx;
  background: #e8f6f3;
  color: #087f88;
  font-size: 21rpx;
  font-weight: 700;
}

.back-link {
  display: inline-block;
  color: #278c8c;
  font-size: 22rpx;
}

.report-card {
  margin-top: 30rpx;
  padding: 26rpx 22rpx;
}

.form-label {
  color: #335c64;
  font-size: 25rpx;
  font-weight: 700;
}

.amount-label, .note-label {
  margin-top: 34rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.choice-chip {
  padding: 13rpx 20rpx;
  border: 1rpx solid #e0eded;
  border-radius: 16rpx;
  background: #f8fbfb;
  color: #6d888e;
  font-size: 22rpx;
}

.choice-chip.selected {
  border-color: #68b8b0;
  background: #eaf8f5;
  color: #087f88;
  font-weight: 600;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.amount-choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8ca1a5;
  font-size: 20rpx;
}

.amount-dot {
  width: 26rpx;
  height: 26rpx;
  margin-bottom: 10rpx;
  border: 5rpx solid #e4efef;
  border-radius: 50%;
  background: #c5d9da;
}

.amount-choice.selected {
  color: #d78c3f;
  font-weight: 600;
}

.amount-choice.selected .amount-dot {
  border-color: #ffedcf;
  background: #e59a4b;
}

.note-input {
  width: 100%;
  height: 150rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e2eded;
  border-radius: 16rpx;
  background: #f9fbfb;
  color: #41636a;
  font-size: 22rpx;
}

.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-draft-btn {
  margin-top: 34rpx;
  padding: 8rpx 13rpx;
  border: 1rpx solid #f0dbb9;
  border-radius: 99rpx;
  background: #fff8eb;
  color: #b87939;
  font-size: 18rpx;
}

.ai-draft-btn.disabled {
  opacity: .55;
}

.privacy-note {
  margin: 20rpx 8rpx;
  color: #9baeb2;
  font-size: 18rpx;
  text-align: center;
}

.submit-btn {
  margin-top: 14rpx;
}

.location-check {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx;
  border: 1rpx solid #efd2aa;
  border-radius: 22rpx;
  background: #fff6e8;
}

.location-check.ready {
  border-color: #a8d9cf;
  background: #eaf8f4;
}

.location-check-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: #e7a252;
  color: #fff;
  font-size: 34rpx;
}

.location-check.ready .location-check-icon {
  background: #36a08e;
}

.location-check-title, .location-check-text {
  display: block;
}

.location-check-title {
  color: #8d632f;
  font-size: 24rpx;
  font-weight: 700;
}

.location-check.ready .location-check-title {
  color: #187a70;
}

.location-check-text {
  margin-top: 6rpx;
  color: #9f8769;
  font-size: 19rpx;
}

.spot-picker {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f1f8f6;
  color: #315e64;
  font-size: 23rpx;
}

.spot-picker.empty { color: #9a6d45; background: #fff7eb; }

.form-hint {
  margin-top: 10rpx;
  color: #91a5a7;
  font-size: 18rpx;
  line-height: 1.5;
}

.submit-btn.disabled {
  opacity: .58;
}
