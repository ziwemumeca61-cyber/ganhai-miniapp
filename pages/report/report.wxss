.report-page { padding-top: 32rpx; }
.circle-head, .circle-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.report-title { color: #173f48; font-size: 40rpx; font-weight: 800; line-height: 1.3; }
.report-subtitle { margin-top: 12rpx; color: #789196; font-size: 24rpx; line-height: 1.6; }
.city-picker { padding: 14rpx 20rpx; border-radius: 99rpx; background: #eaf7f4; color: #087f88; font-size: 26rpx; }
.circle-toolbar { margin: 24rpx 0; color: #789196; font-size: 23rpx; }
.publish-btn { flex-shrink: 0; padding: 14rpx 28rpx; border-radius: 99rpx; background: #087f88; color: #fff; font-size: 25rpx; font-weight: 700; }
.official-card { overflow: hidden; min-height: 160rpx; padding: 14rpx; }
.official-unavailable { padding: 42rpx 24rpx; color: #789196; font-size: 25rpx; line-height: 1.6; text-align: center; }
.sample-entry { padding: 32rpx 8rpx; color: #558083; font-size: 23rpx; text-align: center; }
.back-link { margin-bottom: 22rpx; padding: 12rpx 0; color: #278c8c; font-size: 25rpx; }
.report-card { margin-top: 26rpx; padding: 28rpx; }
.form-label { color: #335c64; font-size: 27rpx; font-weight: 700; }
.amount-label { margin-top: 30rpx; }
.city-form-picker, .spot-picker { display: flex; justify-content: space-between; margin-top: 16rpx; padding: 22rpx; border-radius: 16rpx; background: #f1f8f6; color: #315e64; font-size: 25rpx; }
.chip-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.choice-chip { padding: 16rpx 22rpx; border: 1rpx solid #e0eded; border-radius: 16rpx; background: #f8fbfb; color: #6d888e; font-size: 25rpx; }
.choice-chip.selected { border-color: #68b8b0; background: #eaf8f5; color: #087f88; font-weight: 600; }
.location-check { display: flex; flex-direction: column; gap: 10rpx; margin-top: 24rpx; padding: 24rpx; border-radius: 20rpx; background: #fff6e8; color: #8d632f; font-size: 26rpx; }
.location-check.ready { background: #eaf8f4; color: #187a70; }
.location-check text:last-child { font-size: 22rpx; }
.privacy-note { margin: 22rpx 0; color: #789196; font-size: 22rpx; text-align: center; }
.disabled { opacity: .58; }

.report-title { color: #2d5550; font-size: 43rpx; letter-spacing: 2rpx; }
.circle-toolbar { color: #8c8b73; border-bottom: 2rpx dashed #d9d0b7; padding-bottom: 22rpx; }
.city-picker { border: 1rpx solid #d5cbb2; background: #fffcf2; color: #687c62; border-radius: 5rpx; transform: rotate(2deg); }
.publish-btn { background: #c47753; border-radius: 8rpx; box-shadow: 0 4rpx 0 #a75c40; }
.official-card { border-radius: 9rpx; border-color: #ded5bf; background: #fffcf4; }
.official-unavailable, .report-subtitle, .privacy-note { color: #85856e; }
.sample-entry { color: #8c7c57; }.back-link { color: #92724f; }
.report-card { border-radius: 9rpx; border-color: #dcd3bd; }.form-label { color: #4d6755; }
.choice-chip { border-radius: 7rpx; background: #f7f4e8; border-color: #dcd7bf; color: #7d826c; }.choice-chip.selected { border-color: #b1bc94; background: #e9eedc; color: #587349; }
.city-form-picker, .spot-picker { border-radius: 7rpx; background: #eff0e3; color: #63715b; }
.location-check { border-radius: 8rpx; border: 1rpx dashed #c6ac80; background: #f5ead3; color: #8f7346; }.location-check.ready { background: #e8eddb; color: #627c4d; }
