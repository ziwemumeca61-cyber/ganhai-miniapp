<view class="ai-page">
  <view class="ai-header">
    <view>
      <view class="eyebrow">写下你的海边心愿</view>
      <view class="ai-title">今天想找什么？</view>
      <view class="ai-subtitle">按海况、距离和现场样本筛选</view>
    </view>
    <view class="wish-shell" aria-hidden="true"><view></view><view></view><view></view></view>
  </view>
  <view class="ai-tip"><text class="tip-icon">i</text><text>根据{{cityName}}实时数据，按固定条件筛选。</text></view>

  <scroll-view class="chat-list" scroll-y="true" scroll-into-view="{{scrollId}}" scroll-with-animation="true">
    <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-row {{item.role}}">
      <view wx:if="{{item.role === 'assistant'}}" class="avatar assistant-avatar">贝</view>
      <view class="message-bubble"><text>{{item.content}}</text><text wx:if="{{item.source}}" class="message-source">{{item.source}}</text></view>
      <view wx:if="{{item.role === 'user'}}" class="avatar user-avatar">我</view>
    </view>
    <view wx:if="{{sending}}" class="message-row assistant"><view class="avatar assistant-avatar">贝</view><view class="message-bubble loading-bubble"><text>正在看潮汐和风向</text><view class="typing"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view></view></view></view>
  </scroll-view>

  <view class="suggestion-wrap">
    <view class="suggestion-title">点一张小纸条试试</view>
    <scroll-view class="suggestions" scroll-x="true">
      <text wx:for="{{suggestions}}" wx:key="*this" class="suggestion" data-text="{{item}}" bindtap="chooseSuggestion">{{item}}</text>
    </scroll-view>
  </view>

  <view class="input-bar">
    <input class="chat-input" value="{{inputValue}}" placeholder="例如：想找蛤蜊，去哪里？" confirm-type="send" bindinput="onInput" bindconfirm="submit" />
    <view class="send-btn {{inputValue ? 'ready' : ''}}" bindtap="submit">↑</view>
  </view>
</view>
